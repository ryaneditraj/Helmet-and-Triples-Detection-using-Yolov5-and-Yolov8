# Copy this file to .env. Values already exported in the shell take priority.
# Do not commit .env.

# Dashboard. Use a long random string if the app is reachable beyond your laptop.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# The debugger can execute code. It is refused unless FLASK_HOST is loopback.
FLASK_DEBUG=0
# Set to 1 only when you serve the dashboard over HTTPS.
SESSION_COOKIE_SECURE=0

# Paths. OFFENDERS_STATIC_DIR must stay the Flask static directory so snapshot URLs resolve.
OFFENDERS_DATA_FILE=offenders_data.json
OFFENDERS_STATIC_DIR=static
HELMET_WEIGHTS=best.pt
TRIPLE_WEIGHTS=yolov5s.pt

# Optional camera index. Leave this unset to be prompted by helmets.py and triples.py.
# CAMERA_SOURCE=0
